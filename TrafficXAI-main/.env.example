# TRAFFICX AI — Environment Configuration
# Copy this file to .env and fill in your values

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=trafficx_ai

# MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trafficx_ai

# JWT Secret (for authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys
# Google Maps / OSRM
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=http://localhost:5000

# OpenRouteService
OPENROUTESERVICE_API_KEY=

# Camera / Video Sources
# CCTV_RTSP_URLS=rtsp://camera1:554/stream,rtsp://camera2:554/stream

# AI Model Paths
YOLO_MODEL_PATH=yolov8n.pt
TRAFFIC_PREDICTOR_MODEL_PATH=traffic_predictor.pkl

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# WebSocket
WS_HEARTBEAT_INTERVAL=30

# Simulation
SIMULATION_UPDATE_INTERVAL=5000

# Logging
LOG_LEVEL=INFO